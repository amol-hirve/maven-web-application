pipeline
{
    agent any

    tools
    {
        maven 'Maven_3.9.9'
    }

    environment
    {
        buildNumber = "${BUILD_NUMBER}"
    }

    stages
    {
        stage('Git Checkout')
        {
            steps()
            {
                git branch: 'DevOpsMayBatch', url: 'https://github.com/MithunTechnologiesDevOps/Maven-Web-Application.git'
            }
        }

        stage('Build Project')
        {
            steps()
            {
                sh 'mvn clean package'
            }
        }

        stage('Build Docker Image')
        {
            steps()
            {
                sh 'docker build -t mithuntechnologies/homepage-service:${buildNumber} .'
            }
        }

        stage('Push Docker Image to DockerHub')
        {
            steps()
            {
                withCredentials([string(credentialsId: 'Docker_Hub_Password', variable: 'Docker_Hub_Password')])
                {
                    sh 'docker login -u mithuntechnologies -p ${Docker_Hub_Password}'
                }
                sh 'docker push mithuntechnologies/homepage-service:${buildNumber}'
            }
        }

        stage('Remove Docker Image Locally in Jenkins')
        {
            steps()
            {
                sh 'docker rmi -f mithuntechnologies/homepage-service:${buildNumber}'
            }
        }

        stage('Deploy Application to Deployment Server')
        {
            steps()
            {
                sshagent(credentials: ['DeploymentServer_SSH'])
                {
                    sh "ssh -o StrictHostKeyChecking=no ubuntu@3.109.158.36 docker rm -f maven-container || true"
                    sh "ssh -o StrictHostKeyChecking=no ubuntu@3.109.158.36 docker run  -d --name maven-container -p 8080:8080 mithuntechnologies/homepage-service:${buildNumber}"
                }
            }
        }
    }
}